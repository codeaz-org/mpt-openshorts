# --- Required ---

# aistudio.google.com/app/apikey -- free, generous limits. Drives OpenShorts'
# viral-moment detection, reframing decisions, and hook text.
GEMINI_API_KEY=

# console.cloud.google.com -> APIs & Services -> Credentials -> API key,
# with "YouTube Data API v3" enabled on the project. Read-only search, used
# only by research.py -- separate from the OAuth client below.
YOUTUBE_API_KEY=

# --- YouTube upload (OAuth, direct -- no third party) ---
# Same Cloud project as above, or a separate one: APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Desktop app.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# One-time: NICHE=codeaz python get_youtube_token.py  (suffix comes from
# sources.json niche.env_suffix, not niche.id)
# prints this. Env var name is per-niche: YT_REFRESH_TOKEN_<NICHE-ID-UPPER-ALNUM>
YT_REFRESH_TOKEN_CODEAZ=

# --- TikTok via Buffer ---
# publish.buffer.com/settings/api -- personal API key. Connect your TikTok
# account to Buffer first (publish.buffer.com -> Channels -> Connect -> TikTok).
BUFFER_ACCESS_TOKEN=
# Optional: only needed if more than one TikTok channel is connected to your
# Buffer account. Leave blank to auto-detect the single connected channel.
# BUFFER_CHANNEL_ID_CODEAZ=

# --- Optional ---

# shareNow (default, publishes immediately) | addToQueue | customScheduled
# BUFFER_MODE=shareNow
# Set to 1 to stage TikTok posts as Buffer drafts instead of publishing them
# -- useful while you're still trusting the pipeline.
# BUFFER_DRAFT=1

# Where the OpenShorts backend is reachable. Defaults to localhost:8000,
# which is what `docker compose up backend renderer` gives you.
# OPENSHORTS_BASE_URL=http://localhost:8000

# GITHUB_TOKEN / GITHUB_REPOSITORY are auto-provided inside GitHub Actions
# (used to host each clip as a release asset so Buffer can fetch it). Only
# set these manually if you're running autopilot.py somewhere other than
# Actions and want TikTok posting to work there too.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=your-user/your-repo
